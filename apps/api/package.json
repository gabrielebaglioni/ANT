{
  "name": "@ant/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:dev": "node --import tsx scripts/seed-dev-dashboard.ts",
    "seed:dev:clean": "node --import tsx scripts/clean-dev-demo.ts",
    "db:dev:wipe": "node --import tsx scripts/clean-dev-all.ts"
  },
  "dependencies": {
    "@ant/shared": "workspace:*",
    "@iota/iota-sdk": "^1.2.0",
    "@iota/notarization": "^0.1.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "dotenv": "^16.4.7",
    "minio": "^8.0.6",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
