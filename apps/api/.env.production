# ANT API - PRODUCTION (ready to fill with real values)
# Use secrets manager / runtime env injection in production. Do not commit real secrets.

APP_RUNTIME=deploy
HOST=0.0.0.0
PORT=3000

# Database
DATABASE_URL=postgres://TODO_USER:TODO_PASSWORD@TODO_DB_HOST:5432/ant
PGSSL=true
PGPOOL_MAX=20

# Object storage (S3 / MinIO compatible)
MINIO_ENDPOINT=TODO_S3_OR_MINIO_ENDPOINT
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=TODO_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=TODO_MINIO_SECRET_KEY
MINIO_BUCKET=ant-attachments
MINIO_REGION=eu-central-1

# Workers / monitoring
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_INTERVAL_MS=2000
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MS=15000
MONITORING_ENABLED=true
MONITORING_INTERVAL_MS=30000
ALERT_WEBHOOK_URL=TODO_ALERT_WEBHOOK_URL
ALERT_OUTBOX_MAX_LAG_SECONDS=120
ALERT_OUTBOX_RETRYING_JOBS=5
ALERT_RECON_MISMATCHES_24H=1
ALERT_RECON_FAILURES_1H=1

# Auth (real OIDC)
AUTH_MODE=oidc_jwt
AUTH_OIDC_ISSUER=https://TODO_IDP_ISSUER
AUTH_OIDC_AUDIENCE=ant-api
AUTH_OIDC_JWKS_URL=https://TODO_IDP_JWKS
AUTH_TENANT_CLAIM=tenant_id

# Fallback dev headers (not used in production)
AUTH_DEV_DEFAULT_TENANT=tenant-ant-multientity-network
AUTH_DEV_DEFAULT_ROLES=operator,supervisor,auditor

# Governance / audit
ADMIN_COMPENSATION_REQUIRE_APPROVAL=true
AUDIT_WORM_ARCHIVE_URL=https://TODO_WORM_COLLECTOR_URL
AUDIT_WORM_REQUIRED_IN_DEPLOY=true

# IOTA (real relay/HSM mode)
IOTA_NETWORK=mainnet
IOTA_MODE=relay
IOTA_ALLOW_STUBS=false
IOTA_KEY_SOURCE=relay_hsm
IOTA_ALLOW_ENV_SECRET_IN_DEPLOY=false

# IOTA mainnet relay/fullnode/package
IOTA_MAINNET_TX_RELAY_URL=https://TODO_IOTA_MAINNET_TX_RELAY_URL
IOTA_MAINNET_NOTARIZATION_RELAY_URL=https://TODO_IOTA_MAINNET_NOTARIZATION_RELAY_URL
IOTA_MAINNET_RELAY_API_KEY=TODO_IOTA_RELAY_API_KEY
IOTA_MAINNET_FULLNODE_URL=https://TODO_IOTA_MAINNET_FULLNODE_URL
IOTA_MAINNET_PACKAGE_ID=0xTODO_IOTA_MAINNET_PACKAGE_ID

# DID -> address map for participating entities in this workspace/network
IOTA_DID_ADDRESS_MAP_JSON={"did:iota:producer-prod":"0x...","did:iota:carrier-prod":"0x...","did:iota:receiver-prod":"0x...","did:iota:supervisor-prod":"0x..."}

