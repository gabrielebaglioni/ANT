{
  "name": "ant-monorepo",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "5.3.6"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run -ws build",
    "typecheck": "npm run -ws typecheck",
    "dev:api": "npm --workspace @ant/api run dev",
    "dev:web": "npm --workspace @ant/web run dev"
  }
}
